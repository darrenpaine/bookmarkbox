# Copy to .env and edit. Every setting is optional.

# Signup closes at this many users. 0 is unlimited.
#MAX_USERS=1

# Limits per user. 0 is unlimited.
#MAX_BOOKMARKS_PER_USER=0
#MAX_TAGS_PER_USER=0

# Published port on the host.
#HOST_PORT=4000

# --- Home network without HTTPS -------------------------------------------
# Uncomment BOTH to reach BookmarkBox at http://<server-address>:4000.
# Without COOKIE_SECURE=false the browser drops the session cookie over plain
# HTTP, so logging in just returns to the login page, with no error.
# Don't use these if the server can be reached from the internet.
#BIND_ADDRESS=0.0.0.0
#COOKIE_SECURE=false
