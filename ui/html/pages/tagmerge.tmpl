{{define "title"}}Merge tags{{end}}
{{define "main"}}
<div class='narrow'>
    <h1>Merge tags?</h1>
    <p>
        You already have a tag called <span class='tag {{colour .MergeInto}}'>{{.MergeInto}}</span>.
        <span class='tag {{colour .Tag.Name}}'>{{.Tag.Name}}</span> will merge into it, affecting
        {{.Tag.BookmarkCount}} bookmark{{if ne .Tag.BookmarkCount 1}}s{{end}}.
        This can't be undone.
    </p>
    <div class='form-actions'>
        <form action='/tags/{{.Tag.ID}}/rename' method='POST'>
            <input type='hidden' name='name' value='{{.MergeInto}}'>
            <input type='hidden' name='confirm' value='true'>
            <button class='button primary'>Merge tags</button>
        </form>
        <a class='button' href='/tags'>Cancel</a>
    </div>
</div>
{{end}}
