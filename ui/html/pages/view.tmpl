{{define "title"}}{{.Bookmark.Title}}{{end}}
{{define "main"}}
{{with .Bookmark}}
{{$item := detailsItem .}}
{{$domain := domain .URL}}
<article class='bookmark'>
    <div class='bookmark-head'>
        <span class='ico ico-large {{colour $domain}}' aria-hidden='true'>{{initial $domain}}</span>
        <h1>{{.Title}}</h1>
        {{template "star" $item}}
    </div>
    <p class='url'><a href='{{.URL}}' rel='noopener noreferrer'>{{.URL}}</a></p>
    {{with .Description}}<p class='description'>{{.}}</p>{{end}}
    {{template "tageditor" $}}
    {{with .Notes}}
    <h2>Notes</h2>
    <div class='notes'>{{.}}</div>
    {{end}}
    <div class='bookmark-actions'>
        {{template "readlater" $item}}
        <span class='saved'>Saved {{humanDate .Created}}</span>
        <a class='button' href='/bookmarks/{{.ID}}/edit'>Edit</a>
        <form class='inline' action='/bookmarks/{{.ID}}/delete' method='POST'
            hx-post='/bookmarks/{{.ID}}/delete' hx-confirm='Delete “{{.Title}}”?'>
            <input type='hidden' name='next' value='/'>
            <button class='button danger'>Delete</button>
        </form>
    </div>
</article>
{{end}}
{{end}}
