{{define "title"}}Account{{end}}
{{define "main"}}
<div class='narrow'>
    <h1>Your account</h1>
    {{with .User}}
    <dl class='details'>
        <dt>Name</dt>
        <dd>{{.Name}}</dd>
        <dt>Email</dt>
        <dd>{{.Email}}</dd>
        <dt>Joined</dt>
        <dd>{{humanDate .Created}}</dd>
    </dl>
    <p><a class='button' href='/account/password/update'>Change password</a></p>
    {{end}}
</div>
{{end}}
