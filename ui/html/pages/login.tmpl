{{define "title"}}Log in{{end}}
{{define "main"}}
<div class='narrow'>
    <h1>Log in</h1>
    <form action='/user/login' method='POST' novalidate>
        {{range .Form.NonFieldErrors}}
        <p class='form-error'>{{.}}</p>
        {{end}}
        <div class='field'>
            <label for='email'>Email</label>
            {{with .Form.FieldErrors.email}}<p class='field-error'>{{.}}</p>{{end}}
            <input id='email' type='email' name='email' value='{{.Form.Email}}' autocomplete='email'>
        </div>
        <div class='field'>
            <label for='password'>Password</label>
            {{with .Form.FieldErrors.password}}<p class='field-error'>{{.}}</p>{{end}}
            <input id='password' type='password' name='password' autocomplete='current-password'>
        </div>
        <div class='form-actions'>
            <button class='button primary'>Log in</button>
        </div>
    </form>
</div>
{{end}}
