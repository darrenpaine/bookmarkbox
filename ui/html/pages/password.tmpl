<!-- Form for the password update POST method -->
{{define "title"}}Change Password{{end}}
{{define "main"}}
<form action='/account/password/update' method='POST'>
    {{range .Form.NonFieldErrors}}
    <div class='error'>{{.}}</div>
    {{end}}
    <div>
        <label>Old password:</label>
        {{with .Form.FieldErrors}}
        <label class='error'>{{.old_password}}</label>
        {{end}}
        <input type='password' name='old_password'>
    </div>
    <div>
        <label>New password:</label>
        {{with .Form.FieldErrors}}
        <label class='error'>{{.new_password}}</label>
        {{end}}
        <input type='password' name='new_password'>
    </div>
    <div>
        <label>Confirm new password:</label>
        {{with .Form.FieldErrors}}
        <label class='error'>{{.confirm_password}}</label>
        {{end}}
        <input type='password' name='confirm_password'>
    </div>
    <div>
        <input type='submit' value='Change password'>
    </div>
</form>
{{end}}