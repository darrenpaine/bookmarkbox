{{define "title"}}Home{{end}}
{{define "main"}}
<section class='welcome'>
    <h1>Welcome to bookmarkbox</h1>
    <p>Keep your links in one place, with tags to group them and a star for the
        ones that matter.</p>
    <p class='actions'>
        {{if .SignupOpen}}<a class='button primary' href='/user/signup'>Sign up</a>{{end}}
        <a class='button{{if not .SignupOpen}} primary{{end}}'
            href='/user/login'>Log in</a>
    </p>
</section>
{{with .Demo}}
<section class='welcome demo-box' aria-labelledby='demo-title'>
    <h2 id='demo-title'>Try the demo</h2>
    <p>Log in to the shared Demo account to explore about 200 bookmarks.
        Anyone can change them, and they're put back every day.</p>
    {{template "demologin" .}}
    <p class='demo-own'>Like it? <a
            href='https://github.com/darrenpaine/bookmarkbox/blob/main/docs/self-hosting.md'>Run your own</a>.</p>
</section>
{{end}}
{{end}}
