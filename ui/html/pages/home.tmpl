{{define "title"}}Home{{end}}
{{define "main"}}
{{if .IsAuthenticated}}
<h2>Your Bookmarks</h2>
{{if .Bookmarks}}
<table class='bookmarks'>
    <tr>
        <th>Title</th>
        <th>Tags</th>
        <th>Saved</th>
    </tr>
    {{range .Bookmarks}}
    <tr>
        <td>
            {{if .Favourite}}<span class='star' title='Favourite'>&#9733;</span>{{end}}
            <a href='/bookmarks/{{.ID}}'>{{.Title}}</a>
            <span class='domain'>{{domain .URL}}</span>
        </td>
        <td>{{range .Tags}}<span class='tag'>{{.}}</span> {{end}}</td>
        <td>{{humanDate .Created}}</td>
    </tr>
    {{end}}
</table>
{{else}}
<p>No bookmarks yet. <a href='/bookmarks/new'>Add your first one</a>.</p>
{{end}}
{{else}}
<h2>Welcome to BookmarkBox</h2>
<p>Save, tag and star your bookmarks in one place.</p>
<p>{{if .SignupOpen}}<a href='/user/signup'>Sign up</a> or {{end}}<a href='/user/login'>Log in</a> to get started.</p>
{{end}}
{{end}}
