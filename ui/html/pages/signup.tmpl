{{define "title"}}Sign up{{end}}
{{define "main"}}
<div class='narrow'>
    <h1>Sign up</h1>
    {{if .Demo}}
    <div class='notice'>
        <p>Your account and bookmarks are deleted every 24 hours, and whenever
            the server restarts.</p>
        <p><strong>Don't use a real password.</strong> Any email-shaped text
            works, such as you@example.com. Nothing is ever sent to it.</p>
    </div>
    {{end}}
    <form action='/user/signup' method='POST' novalidate>
        {{range .Form.NonFieldErrors}}
        <p class='form-error'>{{.}}</p>
        {{end}}
        <div class='field'>
            <label for='name'>Name</label>
            {{with .Form.FieldErrors.name}}<p class='field-error'>{{.}}</p>{{end}}
            <input id='name' type='text' name='name' value='{{.Form.Name}}' autocomplete='name'>
        </div>
        <div class='field'>
            <label for='email'>Email</label>
            {{with .Form.FieldErrors.email}}<p class='field-error'>{{.}}</p>{{end}}
            <input id='email' type='email' name='email' value='{{.Form.Email}}' autocomplete='email'>
        </div>
        <div class='field'>
            <label for='password'>Password</label>
            {{with .Form.FieldErrors.password}}<p class='field-error'>{{.}}</p>{{end}}
            <input id='password' type='password' name='password' autocomplete='new-password'>
        </div>
        <div class='form-actions'>
            <button class='button primary'>Sign up</button>
        </div>
    </form>
</div>
{{end}}
