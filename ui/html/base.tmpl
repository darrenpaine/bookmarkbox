{{define "base"}}
<!doctype html>
<html lang='en'{{with .Viewer}}{{if ne .Theme "system"}} data-theme='{{.Theme}}'{{end}}{{end}}>
    <head>
        <meta charset='utf-8'>
        <meta name='viewport' content='width=device-width, initial-scale=1'>
        <meta name='color-scheme' content='{{colorScheme .Viewer}}'>
        <!-- htmx must not add inline styles or run inline code: the CSP forbids both.
             It keeps no copies of pages for Back, so Bookmarks never sit in the browser's storage. -->
        <meta name='htmx-config'
            content='{"includeIndicatorStyles":false,"allowEval":false,"allowScriptTags":false,"historyCacheSize":0,"refreshOnHistoryMiss":true}'>
        <title>{{template "title" .}} - bookmarkbox</title>
        <!-- Fetch the fonts every page uses straight away, so text isn't drawn first in a fallback font -->
        <link rel='preload'
            href='/static/fonts/instrument-sans-latin-400-normal.woff2'
            as='font' type='font/woff2' crossorigin>
        <link rel='preload'
            href='/static/fonts/ibm-plex-sans-condensed-latin-600-normal.woff2'
            as='font' type='font/woff2' crossorigin>
        <link rel='stylesheet' href='{{static "css/main.css"}}'>
        <link rel='icon' href='{{static "img/icon.svg"}}' type='image/svg+xml'>
        <link rel='icon' href='{{static "img/icon-32.png"}}' sizes='32x32'
            type='image/png'>
        <link rel='apple-touch-icon'
            href='{{static "img/apple-touch-icon.png"}}'>
        <script src='{{static "js/htmx-2.0.11.min.js"}}' defer></script>
    </head>
    <body>
        <header class='bar'>
            <a class='wordmark' href='/'>bookmarkbox</a>
            {{if .IsAuthenticated}}
            <div class='nav-wide'>{{template "nav" .}}</div>
            <div class='search-wide'>{{template "search" .}}</div>
            <!-- On narrower screens, a button opens the search below the bar -->
            <details class='search-narrow' {{with .List}}{{if .State.Search}}
                open{{end}}{{end}}>
                <summary class='button' title='Search'>
                    <svg width='18' height='18' viewBox='0 0 24 24' fill='none'
                        stroke='currentColor' stroke-width='2.2'
                        stroke-linecap='round' aria-hidden='true'><circle
                            cx='11' cy='11' r='7' /><path
                            d='m20 20-4-4' /></svg>
                    <span class='visually-hidden'>Search</span>
                </summary>
                <div class='search-panel'>{{template "search" .}}</div>
            </details>
            <a class='button primary' href='/bookmarks/new'>Add<span
                    class='wide-only'>&nbsp;bookmark</span></a>
            <!-- On small screens, the Account link is the User's initial -->
            <a class='account-mark' href='/account/view'{{if hasPrefix .CurrentPath "/account/"}} aria-current='page'{{end}}>
                <span aria-hidden='true'>{{with .Viewer}}{{initial .Name}}{{end}}</span>
                <span class='visually-hidden'>Account</span>
            </a>
            {{else}}
            <div class='bar-end'>
                {{if .SignupOpen}}<a class='button' href='/user/signup'>Sign up</a>{{end}}
                <a class='button primary' href='/user/login'>Log in</a>
            </div>
            {{end}}
        </header>
        {{if .IsAuthenticated}}
        <div class='nav-narrow'>{{template "nav" .}}</div>
        {{end}}
        <main>
            {{with .Flash}}
            <p class='flash{{if $.FlashIsError}} flash-error{{end}}' role='status'>{{.}}</p>
            {{end}}
            {{template "main" .}}
        </main>
        <footer>
            <a href='/about'>About bookmarkbox</a>
        </footer>
    </body>
</html>
{{end}}
